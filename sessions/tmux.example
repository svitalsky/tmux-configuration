#!/bin/bash

# desc: example pre-configured session, just to show some possibilities

set -euo pipefail

# name of the session is determined from the callname suffix
callname="$( basename -- $0 )"
session="${callname##*.}"

# setup lock to avoid race condition
lockdir="${XDG_RUNTIME_DIR:-/tmp}"
lockfile="$lockdir/tmux-session-${session}.lock"
exec 200>"$lockfile"
flock -n 200

# replace with real project root directory
MY_PROJ_DIR="$HOME/myprojects/my-project"

cd "$MY_PROJ_DIR"
if ! tmux has-session -t "$session" 2>/dev/null ; then
    tmux start-server

    # open the session in the root of your project with a split window
    # displaying git graph in the upper part and prompt in the lower one
    # NOTE: we have the following alias lgu in gitconfig (replace with whatever you like):
    # [alias]
    #     lgu = "!f() { num=15; if [ \"$1\" != \"\" ] && ( echo \"$1\" | grep -q \"^[0-9]\\\\+\\$\" ) ; then num=\"$1\" ; shift ; fi ; [ $num -eq 0 ] && num=999999999 ; git \"$@\" log -n \"$num\" --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aD%C(reset) %C(bold green)(%ar)%C(reset)%C(bold yellow)%d%C(reset)%n'' %C(white)%s%C(reset) %C(dim white)- %an%C(reset)' --all; }; f"
    tmux new -d -s $session -n my-project "sleep 1 ; watch -t -c 'git lgu --no-pager -c color.ui=always'"
    tmux split-window -v
    tmux resize-pane -D 7

    # start lazygit in the second window
    tmux new-window -n lazy -t $session:1 lazygit

    # another window in the sources directory
    cd ./sources
    tmux new-window -n sources -t $session:2

    # next go to the dev-server directory
    cd ../dev-server
    # run dev version of the server here
    tmux new-window -n "dev server" -t $session:3 "echo 'java -jar my-app.jar'; sleep 3600"
    # and perhaps 'tail -f myapp.log' here
    tmux split-window -v "echo 'tail -f myapp.log'; sleep 3600"

    # start your work in the project root
    tmux select-window -t $session:0
fi

# release lock before attaching the session
flock -u 200
exec 200>&-

tmux attach -t $session

