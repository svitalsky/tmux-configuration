#!/bin/bash

# desc: mini-session

set -euo pipefail
callname="$( basename -- $0 )"
session="${callname##*.}"

lockdir="${XDG_RUNTIME_DIR:-/tmp}"
lockfile="$lockdir/tmux-session-${session}.lock"
exec 200>"$lockfile"
flock -n 200

if ! tmux has-session -t "$session" 2>/dev/null ; then
    tmux start-server

    tmux new -d -s $session
    tmux new-window -t $session:1
    tmux select-window -t $session:0
fi

flock -u 200
exec 200>&-

tmux attach -t $session

